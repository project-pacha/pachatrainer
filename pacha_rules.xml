  <!-- 3. Legal Right-to-Left Morphotactic Transitions (includes NOMINALIZER tŭ -> PARTICIPLE loop) -->
  <transitions>
    <prev from="CLITIC" to="CLITIC,COP_NEG,NOMINALIZER,PARTICIPLE,VERB_END,POSTP,CASE,PLURAL" />
    <prev from="COP_NEG" to="NOMINALIZER,PARTICIPLE,VERB_END,POSTP,CASE,PLURAL" />
    <prev from="NOMINALIZER" to="PARTICIPLE,VERB_END" />
    <prev from="PARTICIPLE" to="NOMINALIZER,POSTP,CASE,PLURAL" />
    <prev from="VERB_END" to="VERBALIZER" />
    <prev from="VERBALIZER" to="NOMINALIZER,CASE,PLURAL" />
    <prev from="POSTP" to="NOMINALIZER,CASE,PLURAL" />
    <prev from="CASE" to="NOMINALIZER,PLURAL" />
    <prev from="PLURAL" to="NOMINALIZER" />
  </transitions>

