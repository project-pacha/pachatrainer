    <sanskritYClusters items="ky,cy,ṭy,ṇy,ty,ny,py,my,ry,ly,vy,śy" />
    <sanskritVClusters items="kv,cv,ṭv,ṇv,tv,nv,pv,mv,rv,lv,śv" />
    <sanskritClusters>
      <cluster value="kt" /><cluster value="kn" /><cluster value="kp" /><cluster value="km" />
      <cluster value="kr" exceptions="mākri,pōkri" />
      <cluster value="kl" exceptions="klāv" />
      <cluster value="kś" /><cluster value="ṅm" /><cluster value="ṅr" /><cluster value="ṅl" /><cluster value="ṅḷ" />
      <cluster value="ct" /><cluster value="cn" /><cluster value="cm" /><cluster value="cr" /><cluster value="cl" />
      <cluster value="ñk" /><cluster value="ṭk" /><cluster value="ṭṇ" /><cluster value="ṭn" /><cluster value="ṭp" />
      <cluster value="ṭr" /><cluster value="ṭc" /><cluster value="ṅc" /><cluster value="pt" />
      <cluster value="pr" exceptions="prāv" />
      <cluster value="pl" exceptions="plāv,plāmpaḻa" />
      <cluster value="mt" /><cluster value="mn" /><cluster value="mr" />
      <cluster value="ml" exceptions="mlāv" />
      <cluster value="śk" /><cluster value="śc" /><cluster value="śṇ" /><cluster value="śp" />
      <cluster value="śn" /><cluster value="śm" /><cluster value="śl" /><cluster value="śr" />
    </sanskritClusters>
    <sanskritTenseMarkers pattern="karikku|kariccu|karikka|valkkari" />
    <sanskritNominalMarkers items="tvaṁ,tvam,karaṇaṁ,karaṇam,ryaṁ,ryam,ikaṁ,ikam,īyaṁ,īyam,mayaṁ,mayam,paraṁ,param,pūrṇaṁ,pūrṇam,śīlaṁ,śīlam,ātmakaṁ,ātmakam,itaṁ,itam,anīyaṁ,anīyam,tyaṁ,tyam,tamaṁ,tamam,vān,mān,vati,mati,kāran,kāri,vādi,jñan,tāvŭ" />
